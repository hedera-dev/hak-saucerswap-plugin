# SaucerSwap API key — required by the SaucerSwap API (`x-api-key` header).
# Get one from https://www.saucerswap.finance
SAUCERSWAP_API_KEY=

# Router contract IDs (one or both, depending on which pool version you use).
SAUCERSWAP_ROUTER_CONTRACT_ID=
SAUCERSWAP_ROUTER_V2_CONTRACT_ID=

# Wrapped HBAR token ID for swap path resolution.
SAUCERSWAP_WRAPPED_HBAR_TOKEN_ID=

# Optional overrides — leave unset to use defaults.
# SAUCERSWAP_BASE_URL=https://api.saucerswap.finance
# SAUCERSWAP_TIMEOUT_MS=10000
# SAUCERSWAP_RETRIES=2
# SAUCERSWAP_DEFAULT_POOL_VERSION=v2
# SAUCERSWAP_GAS_LIMIT=2000000
# SAUCERSWAP_DEADLINE_MINUTES=20
# SAUCERSWAP_TOKEN_ALIASES={"HBAR":"0.0.987654"}
