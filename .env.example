# SaucerSwap API key — required by the SaucerSwap API (`x-api-key` header).
# Get one from https://www.saucerswap.finance
SAUCERSWAP_API_KEY=

# Network shorthand — set to "mainnet" or "testnet" to load official contract addresses
# automatically. When set, SAUCERSWAP_ROUTER_* and SAUCERSWAP_WRAPPED_HBAR_TOKEN_ID are
# optional (network defaults are used as fallback).
# SAUCERSWAP_NETWORK=mainnet

# Router contract IDs — required if SAUCERSWAP_NETWORK is not set.
# Mainnet: v1=0.0.3045981  v2=0.0.3949434
# Testnet: v1=0.0.19264    v2=0.0.1414040
SAUCERSWAP_ROUTER_CONTRACT_ID=
SAUCERSWAP_ROUTER_V2_CONTRACT_ID=

# Wrapped HBAR token ID — required if SAUCERSWAP_NETWORK is not set.
# Mainnet: 0.0.1456986  Testnet: 0.0.15058
SAUCERSWAP_WRAPPED_HBAR_TOKEN_ID=

# Optional overrides — leave unset to use defaults.
# SAUCERSWAP_BASE_URL=https://api.saucerswap.finance
# SAUCERSWAP_TIMEOUT_MS=10000
# SAUCERSWAP_RETRIES=2
# SAUCERSWAP_DEFAULT_POOL_VERSION=v2
# SAUCERSWAP_GAS_LIMIT=2000000
# SAUCERSWAP_DEADLINE_MINUTES=20
# SAUCERSWAP_TOKEN_ALIASES={"HBAR":"0.0.987654"}
